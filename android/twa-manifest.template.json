{
  "packageId": "io.github.aayush4jha.orbit",
  "host": "__HOST__",
  "name": "Orbit",
  "launcherName": "Orbit",
  "display": "standalone",
  "themeColor": "#FAF9F7",
  "themeColorDark": "#151413",
  "navigationColor": "#FAF9F7",
  "navigationColorDark": "#151413",
  "navigationDividerColor": "#E6E4E1",
  "navigationDividerColorDark": "#2A2826",
  "backgroundColor": "#FAF9F7",
  "enableNotifications": true,
  "startUrl": "/inbox?source=android",
  "iconUrl": "__ASSET_BASE__/icons/icon-512.png",
  "maskableIconUrl": "__ASSET_BASE__/icons/maskable-512.png",
  "monochromeIconUrl": "__ASSET_BASE__/icons/badge-96.png",
  "splashScreenFadeOutDuration": 300,
  "signingKey": { "path": "__KEYSTORE__", "alias": "orbit" },
  "appVersionCode": __VERSION_CODE__,
  "appVersion": "__VERSION__",
  "shortcuts": [
    { "name": "New message", "shortName": "Compose", "url": "/share?source=shortcut", "chosenIconUrl": "__ASSET_BASE__/icons/shortcut-compose.png" },
    { "name": "Unread", "shortName": "Unread", "url": "/inbox?folder=unread&source=shortcut", "chosenIconUrl": "__ASSET_BASE__/icons/shortcut-unread.png" },
    { "name": "Search", "shortName": "Search", "url": "/search?source=shortcut", "chosenIconUrl": "__ASSET_BASE__/icons/shortcut-search.png" },
    { "name": "Follow-ups", "shortName": "Follow-ups", "url": "/follow-ups?source=shortcut", "chosenIconUrl": "__ASSET_BASE__/icons/shortcut-followups.png" }
  ],
  "generatorApp": "bubblewrap-cli",
  "webManifestUrl": "__ASSET_BASE__/manifest.webmanifest",
  "fallbackType": "customtabs",
  "features": {},
  "alphaDependencies": { "enabled": false },
  "enableSiteSettingsShortcut": true,
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "fullScopeUrl": "https://__HOST__/",
  "minSdkVersion": 24,
  "orientation": "default",
  "shareTarget": { "action": "/share", "method": "GET", "params": { "title": "title", "text": "text", "url": "url" } },
  "fingerprints": [],
  "additionalTrustedOrigins": [],
  "retainedBundles": [],
  "protocolHandlers": [],
  "fileHandlers": []
}
