# Orbit configuration. Copy to .env.local and fill in what you need.
# With nothing set, Orbit runs as a local sample workspace.

# ---- Public URL (needed for webhooks + OAuth redirects in production)
ORBIT_PUBLIC_URL=            # e.g. https://orbit.example.com (no trailing slash)

# ---- Supabase (auth + Postgres). Run supabase/migrations/0001_init.sql on your project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server only, never exposed to the browser

# ---- Secrets
ORBIT_TOKEN_ENCRYPTION_KEY=  # 32 bytes base64: openssl rand -base64 32
ORBIT_STATE_SECRET=          # optional; defaults to the encryption key
CRON_SECRET=                 # bearer token for /api/cron/sync

# ---- Gmail / Google Workspace (Google Cloud Console → OAuth client "Web application")
# Authorized redirect URI: ${ORBIT_PUBLIC_URL}/api/connectors/gmail/callback
# Enable the Gmail API. gmail.modify is a restricted scope: add yourself as a test user until verified.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Gmail push: create a Pub/Sub topic, grant gmail-api-push@system.gserviceaccount.com "Publisher",
# and add a push subscription to ${ORBIT_PUBLIC_URL}/api/webhooks/gmail?token=${GOOGLE_PUBSUB_VERIFICATION_TOKEN}
GOOGLE_PUBSUB_TOPIC=         # projects/<project>/topics/<topic>
GOOGLE_PUBSUB_VERIFICATION_TOKEN=

# ---- Outlook / Microsoft 365 (Entra admin center → App registrations → "Accounts in any organizational
# directory and personal Microsoft accounts"). Redirect URI (Web): ${ORBIT_PUBLIC_URL}/api/connectors/outlook/callback
# API permissions (delegated): User.Read, Mail.ReadWrite, Mail.Send, offline_access.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---- Slack (api.slack.com/apps → OAuth & Permissions → add the user scopes listed in docs/INTEGRATIONS.md)
# Redirect URL: ${ORBIT_PUBLIC_URL}/api/connectors/slack/callback
# Event Subscriptions request URL: ${ORBIT_PUBLIC_URL}/api/webhooks/slack (subscribe to message.* user events)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_HISTORY_LIMIT=15       # raise for internal / Marketplace-approved apps

# ---- Meta business messaging (developers.facebook.com → your app). Business accounts only.
# Webhook callback URL: ${ORBIT_PUBLIC_URL}/api/webhooks/meta (verify token below); subscribe to
# page: messages,message_echoes · instagram: messages · whatsapp_business_account: messages
META_APP_ID=                 # Messenger (Facebook Login for Business)
META_APP_SECRET=             # also verifies X-Hub-Signature-256 on webhooks
META_WEBHOOK_VERIFY_TOKEN=   # any random string; enter the same value in the dashboard
META_GRAPH_VERSION=v24.0
META_HUMAN_AGENT_ENABLED=false  # true only if your app has the Human Agent permission (7-day window)
INSTAGRAM_APP_ID=            # Instagram API with Instagram Login
INSTAGRAM_APP_SECRET=
# OAuth redirect URIs: ${ORBIT_PUBLIC_URL}/api/connectors/messenger/callback and /api/connectors/instagram/callback
# WhatsApp: connect your number in Settings with a system-user token + phone number ID.

# ---- Telegram: no app credentials; users paste a bot token from @BotFather in Settings.

# ---- AI (Anthropic). Without a key, AI features show their rule-based fallbacks.
ANTHROPIC_API_KEY=
ORBIT_AI_MODEL=claude-opus-5-5
